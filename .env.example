# ── Supabase (optional — without these the app runs in "Local mode",
#    persisting everything to IndexedDB in the browser) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used for auth redirects (OAuth, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI text / design provider (server-side only, never exposed) ────────────
# AI_TEXT_PROVIDER = anthropic | openai | local   (default: auto-detect, falls back to local)
AI_TEXT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# ── AI image provider ──────────────────────────────────────────────────────
# AI_IMAGE_PROVIDER = openai | replicate  (default: auto-detect)
AI_IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ── Background removal (optional; a basic in-browser fallback exists) ─────
REMOVE_BG_API_KEY=

# ── Stock photos (optional; Openverse open-license search works without a key)
UNSPLASH_ACCESS_KEY=

# ── Rate limiting for AI endpoints (requests per minute per user/IP) ──────
AI_RATE_LIMIT_PER_MINUTE=20
